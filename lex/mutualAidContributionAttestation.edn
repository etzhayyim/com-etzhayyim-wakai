{"lexicon" 1,
 "id" "com.etzhayyim.wakai.mutualAidContributionAttestation",
 "description"
 "Per-member contribution attestation. G6 STRUCTURAL: investmentReturnPromised const false (Charter Rider §2(b) speculative finance prohibition). G8 STRUCTURAL: voluntary + ability-scaled; no premium-as-contract. Contribution amounts stored encrypted (member-by-amount linkage is PII); aggregate published only.",
 "defs"
 {"main"
  {"type" "record",
   "key" "tid",
   "record"
   {"type" "object",
    "required"
    ["createdAt"
     "contributorPseudonymDid"
     "contributionAmountEncryptedCid"
     "memberConsentCid"
     "investmentReturnPromised"
     "contributionMethod"
     "attestingCellDid"],
    "properties"
    {"investmentReturnPromised"
     {"type" "boolean",
      "const" false,
      "description"
      "G6 STRUCTURAL: const false; Charter Rider §2(b) speculative finance prohibition; mutual aid pool is solidarity reserve, NOT investment vehicle"},
     "kotobaDatomicAttestationCid" {"type" "string"},
     "createdAt" {"type" "string", "format" "datetime"},
     "abilityScaledAttested"
     {"type" "boolean",
      "description"
      "G8: member self-attests ability-scaled contribution"},
     "charterRiderScanPass" {"type" "boolean"},
     "stewardLaborAttestationCid"
     {"type" "string",
      "description"
      "When labor-equivalent contribution, cross-link to chigiri.stewardLaborAttestation"},
     "contributionAmountEncryptedCid"
     {"type" "string",
      "description"
      "ADR-2605181100 encrypted envelope CID containing contribution amount (PII; not exposed publicly)"},
     "contributorPseudonymDid"
     {"type" "string",
      "description"
      "30-day rotating pseudonym DID per ADR-2605181200; member-by-amount linkage avoided"},
     "contributionMethod"
     {"type" "string",
      "knownValues"
      ["usdc-base-l2-direct"
       "usdc-base-l2-erc4337-paymaster"
       "in-kind-attested"
       "labor-equivalent-attested"]},
     "memberConsentCid"
     {"type" "string",
      "description"
      "Member consent record for contribution + privacy posture"},
     "contributionTxCid"
     {"type" "string",
      "description"
      "On-chain USDC transaction CID (when applicable; in-kind/labor variants attested separately)"},
     "attestingCellDid" {"type" "string"}}}}}}
